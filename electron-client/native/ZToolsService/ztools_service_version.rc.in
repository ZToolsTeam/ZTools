1 VERSIONINFO
FILEVERSION @ZTOOLS_PRODUCT_VERSION_RC@
PRODUCTVERSION @ZTOOLS_PRODUCT_VERSION_RC@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "ZTools administrator service"
            VALUE "FileVersion", "@ZTOOLS_PRODUCT_VERSION@"
            VALUE "InternalName", "ZToolsService"
            VALUE "OriginalFilename", "ZToolsService.exe"
            VALUE "ProductName", "ZTools"
            VALUE "ProductVersion", "@ZTOOLS_PRODUCT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
