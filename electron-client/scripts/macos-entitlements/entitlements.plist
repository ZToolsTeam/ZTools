<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ZTools 主程序签名权限（Developer ID + 加固运行时）。只加实际用到的：
  - allow-jit：V8 / WebAssembly 需要 JIT，缺了渲染进程起不来；
  - automation.apple-events：窗口管理、粘贴、获取应用图标等通过 osascript 发送 Apple 事件，加固运行时下没有这一项会被系统拒绝。
  不加 disable-library-validation：所有原生模块都由同一证书重新签名，保持库校验。
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
