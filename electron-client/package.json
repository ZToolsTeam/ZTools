{
  "name": "ztools-electron-client",
  "version": "1.1.8.5",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "ZTools Electron Windows x64 client",
  "main": "out/main/bootstrap.js",
  "type": "commonjs",
  "scripts": {
    "lint": "tsc --noEmit -p tsconfig.json && node scripts/verify-source.mjs",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.test.json && node scripts/run-tests.mjs",
    "test:preload:sandbox": "node --test scripts/test-sandbox-preload-bundle.mjs",
    "test:quick": "node scripts/run-test-workflow.mjs quick",
    "test:plugins": "node scripts/run-test-workflow.mjs plugins",
    "test:full": "node scripts/run-test-workflow.mjs full",
    "test:release": "node scripts/run-test-workflow.mjs release",
    "test:package:win32:x64": "node --test scripts/test-package-win32-x64.mjs",
    "test:package:macos-universal": "node --test scripts/test-package-macos-universal.mjs",
    "test:package:macos-dmg": "node --test scripts/test-package-macos-dmg.mjs",
    "build": "node scripts/build.mjs",
    "build:native:sidecars": "node scripts/build-sidecars.mjs",
    "test:sidecars": "node scripts/test-sidecars.mjs",
    "build:native-host32": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native-host32.ps1 -Configuration Release",
    "test:native-host32:focused": "node scripts/test-native-host32-focused.mjs",
    "build:ztools-service": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-ztools-service.ps1 -Configuration Release",
    "test:ztools-service": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-ztools-service.ps1 -Configuration Release -SelfTest && npm exec -- tsc -p tsconfig.json && node scripts/build-sandbox-preload.mjs && node scripts/test-ztools-service.mjs",
    "start:mac": "node scripts/start-macos.mjs",
    "sign:mac:prototype": "node scripts/sign-macos.mjs",
    "test:mac:integration": "node scripts/macos-app-integration.mjs",
    "test:mac:normal-app:database-chain": "node scripts/test-macos-normal-app-database-chain.mjs",
    "test:mac:release": "node scripts/macos-release.mjs",
    "test:mac:preflight": "node scripts/macos-preflight.mjs",
    "test:mac:path-names:apfs": "node --experimental-sqlite scripts/macos-path-names-apfs.mjs",
    "test:mac:fixtures:apfs": "node --experimental-sqlite scripts/macos-apfs-fixtures.mjs",
    "test:mac:fixtures:data": "node scripts/macos-data-fixtures-entry.mjs",
    "test:mac:fixtures": "node --experimental-sqlite scripts/macos-fixtures.mjs",
    "test:native:path-access": "node scripts/test-native-path-access.mjs",
    "test:win:path-journal:recovery": "node scripts/test-windows-path-journal-recovery.mjs",
    "test:win:path-journal:sealing": "node scripts/test-windows-path-journal-sealing.mjs",
    "test:native:portable:clipboard": "node scripts/test-portable-macos-clipboard.mjs",
    "test:native:mac:clipboard": "node scripts/test-native-macos-clipboard.mjs",
    "test:native:mac:paste-session": "node scripts/test-macos-paste-session.mjs",
    "build:native:mac:vision": "node scripts/build-macos-vision.mjs",
    "test:native:mac:vision": "node scripts/test-native-macos-vision.mjs",
    "test:native:mac:host:contracts": "node scripts/test-macos-native-host-contracts.mjs",
    "build:native:mac:clipboard": "node scripts/build-macos-clipboard.mjs",
    "build:native:mac:path-access": "node scripts/build-macos-path-access.mjs",
    "build:native:win:path-access": "node scripts/build-windows-path-access.mjs",
    "build:native:win:path-access-broker": "node scripts/build-sidecars.mjs --path-access-broker",
    "test:win:reference:resources": "node scripts/test-file-resource-dispatch.mjs",
    "test:win:reference:images": "node scripts/test-windows-reference-images.mjs",
    "test:win:normal-app:plugin-file-chain": "node scripts/test-windows-normal-app-plugin-file-chain.mjs",
    "test:win:normal-app:plugin-file-chain:lib": "node --test scripts/test-windows-normal-app-plugin-file-chain-lib.mjs",
    "test:win:normal-app:config-restart:contracts": "node --test scripts/test-windows-normal-app-config-restart-contract.mjs",
    "test:win:normal-app:config-restart": "node scripts/test-windows-normal-app-config-restart.mjs",
    "test:win:normal-app:database-chain": "node scripts/test-windows-normal-app-database-chain.mjs",
    "test:win:normal-app:permission-monitor": "node scripts/test-windows-normal-app-permission-monitor.mjs",
    "test:mac:reference:images": "node scripts/test-macos-reference-images.mjs",
    "test:mac:coverage": "node scripts/macos-plugin-coverage.mjs",
    "test:reference:gif": "node scripts/test-reference-gif.mjs",
    "test:reference:sqlite": "node scripts/test-reference-sqlite.mjs",
    "test:reference:zip": "node scripts/test-reference-zip.mjs",
    "test:mac:contracts": "node scripts/run-test-workflow.mjs mac-contracts",
    "start": "npm run build:native-host32 && npm run build && electron .",
    "package:app:win32:x64": "npm run build:native-host32 && npm run build:ztools-service && npm run build:native:win:path-access-broker && npm run build && node scripts/package.mjs",
    "package:app:darwin:universal": "node scripts/package-macos-universal.mjs",
    "package:dmg:darwin": "node scripts/package-macos-dmg.mjs",
    "test:portable-contract": "tsc -p tsconfig.test.json && node scripts/run-tests.mjs portable-contract",
    "build:native:mac:audio": "node scripts/build-macos-audio.mjs",
    "test:native:mac:audio": "node --test scripts/test-macos-audio.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@electron/asar": "4.3.0",
    "@electron/packager": "20.3.0",
    "@types/node": "24.3.0",
    "@types/omggif": "1.0.5",
    "@types/plist": "3.0.5",
    "@types/pngjs": "6.0.5",
    "@types/sql.js": "1.4.11",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "electron": "43.4.1",
    "omggif": "1.0.10",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "classic-level": "3.0.0",
    "docx": "9.14.0",
    "gifenc": "1.0.3",
    "ini": "6.0.0",
    "marked": "18.1.1",
    "pinyin-pro": "3.28.1",
    "plist": "3.1.1",
    "pngjs": "7.0.0",
    "sql.js": "1.14.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "optionalDependencies": {
    "exiftool-vendored.exe": "13.59.3",
    "exiftool-vendored.pl": "13.59.3"
  }
}
