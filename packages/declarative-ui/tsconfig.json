{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "jsx": "react",
    "jsxFactory": "React.createElement",
    "jsxFragmentFactory": "React.Fragment",
    "typeRoots": [
      "./node_modules/@types",
      "../../electron-client/node_modules/@types"
    ],
    "types": [
      "node"
    ],
    "noImplicitAny": false
  },
  "include": [
    "src/**/*"
  ]
}
