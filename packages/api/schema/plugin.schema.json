{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ztools.cn/schemas/plugin.schema.json",
  "title": "ZTools Plugin Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "name", "version", "description", "author", "entry", "icon", "window"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "description": { "type": "string", "minLength": 1 },
    "category": { "type": "array", "items": { "type": "string" }, "default": [] },
    "author": { "type": "string", "minLength": 1 },
    "entry": { "$ref": "#/$defs/relativePath" },
    "keyword": { "type": "string", "minLength": 1 },
    "keywords": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "icon": { "$ref": "#/$defs/relativePath" },
    "dllloader": { "allOf": [{ "$ref": "#/$defs/relativePath" }, { "pattern": "\\.[dD][lL][lL]$" }] },
    "requireAdmin": { "type": "boolean", "default": false },
    "commonLibs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "allOf": [
          { "$ref": "../contracts/platform-target.schema.json" },
          { "type": "object", "required": ["id"] }
        ]
      },
      "description": "Explicit platform/runtime/architecture compatibility claims. Omission is legacy compatibility and does not imply macOS support."
    },
    "nativeComponents": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nativeComponent" },
      "description": "Native components are bound to exactly one declared target. Component arch describes the actual binary architecture. The only x64 Windows Electron cross-architecture bindings are an ia32 NativeHost32 DLL and explicitly bound ia32 Windows PE dependencies. Use an empty array for explicit JavaScript-only targets."
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "explain"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "explain": { "type": "string", "minLength": 1 },
          "icon": { "$ref": "#/$defs/relativePath" },
          "cmds": {
            "type": "array",
            "items": {
              "anyOf": [
                { "type": "string", "minLength": 1 },
                { "type": "object" }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "window": {
      "type": "object",
      "required": ["width", "height", "resizable", "singleInstance"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "minWidth": { "type": "integer", "minimum": 0 },
        "minHeight": { "type": "integer", "minimum": 0 },
        "resizable": { "type": "boolean" },
        "singleInstance": { "type": "boolean" },
        "controls": {
          "type": "object",
          "required": ["minimize", "maximize"],
          "properties": {
            "minimize": { "type": "boolean" },
            "maximize": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": { "required": ["targets"] },
      "then": { "required": ["nativeComponents"] }
    },
    {
      "if": { "required": ["nativeComponents"] },
      "then": { "required": ["targets"] }
    },
    {
      "if": { "required": ["targets"] },
      "then": {
        "propertyNames": {
          "enum": [
            "id",
            "name",
            "version",
            "description",
            "category",
            "author",
            "entry",
            "keyword",
            "keywords",
            "icon",
            "dllloader",
            "requireAdmin",
            "commonLibs",
            "targets",
            "nativeComponents",
            "features",
            "window"
          ]
        }
      }
    }
  ],
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(^[\\\\/])|(^[A-Za-z]:)|(^|[\\\\/])\\.\\.([\\\\/]|$)|[\\u0000-\\u001f\\u007f]|(^|[\\\\/])[^\\\\/]*:[^\\\\/]*([\\\\/]|$)"
      }
    },
    "nativeComponent": {
      "type": "object",
      "required": ["id", "kind", "targetId", "arch", "abi", "entry"],
      "properties": {
        "id": { "$ref": "../contracts/platform-target.schema.json#/properties/id" },
        "kind": { "type": "string", "enum": ["dll", "shared-library", "worker"] },
        "targetId": { "$ref": "../contracts/platform-target.schema.json#/properties/id" },
        "arch": {
          "allOf": [
            { "$ref": "../contracts/platform-target.schema.json#/properties/arch" },
            { "not": { "const": "any" } }
          ]
        },
        "abi": { "$ref": "../contracts/platform-target.schema.json#/properties/abi" },
        "entry": { "$ref": "#/$defs/relativePath" },
        "protocolVersion": { "type": "integer", "minimum": 1 },
        "hostComponentId": { "$ref": "../contracts/platform-target.schema.json#/properties/id" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "payloadFiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/nativePayloadFile" },
          "description": "Explicit package files owned by this NativeHost DLL and its target. This metadata grants no execution or loading authority."
        }
      },
      "allOf": [
        {
          "if": { "required": ["payloadFiles"] },
          "then": {
            "required": ["sha256", "protocolVersion"],
            "properties": {
              "kind": { "const": "dll" },
              "arch": { "const": "ia32" },
              "abi": { "const": "ztools-native-host/v1" },
              "protocolVersion": { "const": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "abi": { "const": "ztools-native-host/v1" } },
            "required": ["abi"]
          },
          "then": {
            "required": ["protocolVersion"],
            "properties": {
              "kind": { "const": "dll" },
              "arch": { "const": "ia32" },
              "protocolVersion": { "const": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "abi": { "const": "windows-pe/v1" } },
            "required": ["abi"]
          },
          "then": {
            "properties": {
              "kind": { "const": "shared-library" },
              "arch": { "const": "ia32" },
              "entry": { "pattern": "\\.[dD][lL][lL]$" }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nativePayloadFile": {
      "type": "object",
      "required": ["entry", "format", "sha256"],
      "properties": {
        "entry": {
          "allOf": [
            { "$ref": "#/$defs/relativePath" },
            { "pattern": "^lib/(?:[^\\\\/]+/)*[^\\\\/]+$" },
            { "not": { "pattern": "(^|/)\\.\\.?(/|$)|[<>\"|?*]|[. ](/|$)" } }
          ]
        },
        "format": { "type": "string", "enum": ["pe", "data"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "arch": { "type": "string", "enum": ["ia32", "x64"] }
      },
      "allOf": [
        {
          "if": { "properties": { "format": { "const": "pe" } }, "required": ["format"] },
          "then": {
            "required": ["arch"],
            "properties": { "entry": { "pattern": "\\.(?:[dD][lL][lL]|[eE][xX][eE])$" } }
          },
          "else": {
            "not": { "required": ["arch"] },
            "properties": { "entry": { "not": { "pattern": "\\.(?:[dD][lL][lL]|[eE][xX][eE])$" } } }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
