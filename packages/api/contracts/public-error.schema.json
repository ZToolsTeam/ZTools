{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ztools.cn/contracts/public-error.schema.json",
  "title": "ZTools public IPC error",
  "type": "object",
  "required": ["code", "message"],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "message": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
