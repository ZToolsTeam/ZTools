{
  "name": "ztools",
  "version": "1.1.8.1",
  "private": true,
  "description": "ZTools - 纯粹开源、免费极客、轻量宿主、极致性能的现代化双端效率中枢平台",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/dev-bootstrap.mjs --install-only",
    "dev": "node scripts/dev-bootstrap.mjs",
    "start": "node scripts/dev-bootstrap.mjs",
    "start:rebuild": "node scripts/dev-bootstrap.mjs --force-build",
    "pretest": "node packages/declarative-ui/scripts/ensure-dist.mjs",
    "test": "node --test tests/e2e-cross-module-resilience.test.mjs",
    "test:anti-reverse": "node --test tests/anti-reverse-resilience.test.mjs",
    "test:winget": "node --test tests/publish-winget.test.mjs",
    "test:quick": "npm --prefix electron-client run test:quick",
    "test:dx": "node --test tests/dx-create-plugin.test.mjs",
    "create-plugin": "node scripts/create-plugin.mjs",
    "scan-plugins": "node scripts/scan-plugin-security.mjs",
    "changelog": "node scripts/update-changelog.mjs",
    "release": "node scripts/sync-release.mjs all",
    "release:oss": "node scripts/sync-release.mjs oss",
    "release:extensions": "node scripts/sync-release.mjs extensions",
    "package:release": "node scripts/package-release-binaries.mjs",
    "release:binaries": "node scripts/package-release-binaries.mjs --upload",
    "release:winget": "node scripts/publish-winget.mjs",
    "release:winget:dry-run": "node scripts/publish-winget.mjs --dry-run",
    "start:mac": "npm --prefix electron-client run start:mac",
    "package:mac": "npm --prefix electron-client run package:app:darwin:universal --",
    "package:mac:dmg": "npm --prefix electron-client run package:dmg:darwin --",
    "release:mac": "node scripts/build-macos-remote.mjs",
    "release:mac:download": "node scripts/build-macos-remote.mjs --download",
    "release:mac:dry-run": "node scripts/build-macos-remote.mjs --dry-run",
    "prepare": "node scripts/install-git-hooks.mjs",
    "quality:fast": "node scripts/quality-gate.mjs --fast",
    "quality:gate": "node scripts/quality-gate.mjs",
    "quality:staged": "node scripts/quality-gate.mjs --staged",
    "quality:push": "node scripts/quality-gate.mjs --push",
    "test:quality-gate": "node --test scripts/quality-gate.test.mjs"
  },
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "ztools",
    "declarative-components",
    "productivity",
    "launcher",
    "declarative-ui",
    "mcp"
  ],
  "author": "ZTools Team",
  "license": "MIT"
}
