# =============================================================================
# ZTools Open Source Environment Configuration Template
# 复制本文件为 .env.local 并填入你自己的配置
# =============================================================================

# 1. AI 平台配置 (BYOK: Bring Your Own Key)
# 支持 DeepSeek, OpenAI, Claude, 硅基流动等
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-reasoner

# 2. 本地离线模型嗅探配置 (Ollama / LM Studio)
LOCAL_OLLAMA_URL=http://127.0.0.1:11434
LOCAL_LMSTUDIO_URL=http://127.0.0.1:1234

# 3. 去中心化端到端加密同步配置 (可选: WebDAV / GitHub Gist)
SYNC_STORAGE_TYPE=webdav
SYNC_WEBDAV_ENDPOINT=
SYNC_WEBDAV_USER=
SYNC_WEBDAV_PASSWORD=
SYNC_PASSPHRASE=

# 4. 插件去中心化静态分发目录 (留空时默认使用内置与本地清单)
VITE_API_BASE_URL=
