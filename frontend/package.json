{
  "name": "ztools-frontend",
  "private": true,
  "version": "1.1.8.0",
  "type": "module",
  "scripts": {
    "predev": "node ../packages/declarative-ui/scripts/ensure-dist.mjs && node ./public/js/cef-ipc/build.cjs",
    "dev": "vite",
    "build:sdk": "node ./public/js/cef-ipc/build.cjs && node ./scripts/verify-sdk-sync.mjs",
    "prebuild": "node ../packages/declarative-ui/scripts/ensure-dist.mjs && node ./public/js/cef-ipc/build.cjs && node scripts/generate-version.cjs && node ./scripts/verify-sdk-sync.mjs",
    "build": "vite build",
    "postbuild": "node scripts/pack-dist.cjs",
    "preview": "vite preview",
    "prettier": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "node scripts/e2e-test/index.cjs",
    "test:all": "vitest run && node scripts/e2e-test/index.cjs",
    "pretest": "node ../packages/declarative-ui/scripts/ensure-dist.mjs",
    "pretest:all": "node ../packages/declarative-ui/scripts/ensure-dist.mjs"
  },
  "dependencies": {
    "ant-design-vue": "^4.2.6",
    "axios": "^1.13.2",
    "font-awesome": "^4.7.0",
    "pinia": "^2.1.7",
    "pinyin-pro": "3.28.1",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.16",
    "baseline-browser-mapping": "^2.9.13",
    "fast-check": "^4.5.3",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.32",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.0",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^5.0.0",
    "vitest": "^4.0.17"
  }
}
