{
  "id": "translator",
  "name": "划词翻译",
  "description": "中英互译常用词与办公短语（只查客户端内置的离线词库，收录有限），并把英文转成 camelCase / snake_case 变量名",
  "version": "2.0.2",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "alias": "tr",
  "category": [
    "办公效率",
    "文本工具"
  ],
  "keywords": [
    "translate",
    "translator",
    "dictionary",
    "english",
    "chinese",
    "翻译",
    "划词翻译",
    "词典",
    "中英互译",
    "变量命名"
  ],
  "features": [
    {
      "code": "translate-standard",
      "explain": "中英互译（客户端离线词库，收录有限）",
      "mode": "view",
      "cmds": [
        "翻译",
        "划词翻译",
        "中英互译",
        "英文翻译",
        "translate"
      ]
    },
    {
      "code": "translate-dict",
      "explain": "查中英常用词的译文（客户端离线词库，收录有限）",
      "mode": "view",
      "cmds": [
        "词典",
        "查词",
        "单词",
        "dictionary"
      ]
    },
    {
      "code": "translate-naming",
      "explain": "中文翻译成英文变量名（camelCase / snake_case）",
      "mode": "view",
      "cmds": [
        "变量命名",
        "代码命名",
        "驼峰命名",
        "camelcase"
      ]
    }
  ],
  "permissions": [
    "clipboard"
  ],
  "requireAdmin": false,
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    }
  ]
}
