{
  "id": "invoice-assistant",
  "name": "发票助手",
  "description": "扫描下载、桌面、文档目录中的 PDF/XML 电子发票，识别发票号码、开票日期、销售方、购买方与金额（识别不到的字段需手动补全后才能导出），支持发票号查重、个人抬头提示、按模板复制规范命名的发票副本、导出报销明细 CSV 与复制表格文本",
  "version": "1.1.4",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "alias": "fp",
  "category": [
    "办公效率",
    "文档处理"
  ],
  "keywords": [
    "invoice",
    "fapiao",
    "reimbursement",
    "pdf",
    "csv",
    "excel",
    "发票",
    "报销",
    "电子发票",
    "数电票"
  ],
  "features": [
    {
      "code": "invoice-reimburse",
      "explain": "电子发票汇总与导出报销明细",
      "mode": "view",
      "cmds": [
        "发票报销",
        "报销台账",
        "发票汇总",
        "导出报销单",
        "数电票",
        "电子发票"
      ]
    },
    {
      "code": "invoice-rename",
      "explain": "按模板复制规范命名的电子发票副本",
      "mode": "view",
      "cmds": [
        "发票重命名",
        "发票改名",
        "归档重命名"
      ]
    },
    {
      "code": "invoice-travel",
      "explain": "差旅交通与住宿发票筛选",
      "mode": "view",
      "cmds": [
        "差旅发票",
        "打车票",
        "高铁票",
        "交通发票",
        "酒店发票"
      ]
    }
  ],
  "permissions": [
    "fs",
    "clipboard",
    "shell"
  ],
  "requireAdmin": false,
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    }
  ]
}
