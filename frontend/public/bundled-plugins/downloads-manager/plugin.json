{
  "id": "downloads-manager",
  "name": "下载管理",
  "description": "聚合已识别的系统下载、网盘与接收目录，支持自定义目录、筛选、打开和安全回收；扫描不完整时明确提示",
  "version": "2.1.5",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "category": [
    "效率工具",
    "系统工具"
  ],
  "permissions": [
    "fs",
    "system",
    "clipboard",
    "shell"
  ],
  "requireAdmin": false,
  "nativeComponents": [],
  "features": [
    {
      "code": "downloads-all",
      "explain": "浏览和筛选已识别下载目录与自定义目录中的文件",
      "cmds": [
        "下载",
        "下载管理",
        "downloads",
        "dl",
        "最近下载",
        "接收文件"
      ]
    },
    {
      "code": "downloads-netdisk",
      "explain": "筛选已识别的网盘和下载器目录中的文件",
      "cmds": [
        "网盘下载",
        "百度网盘",
        "夸克下载",
        "迅雷下载",
        "netdisk"
      ]
    },
    {
      "code": "downloads-im",
      "explain": "筛选已识别的办公软件接收目录中的文件，未识别目录可自行添加",
      "cmds": [
        "微信文件",
        "微信接收",
        "QQ文件",
        "飞书文件",
        "钉钉文件"
      ]
    },
    {
      "code": "downloads-clean-installers",
      "explain": "筛选当前列出的安装包，经确认后将未保护项移入回收站",
      "cmds": [
        "清理安装包",
        "删除安装包",
        "installers"
      ]
    }
  ],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ]
}
