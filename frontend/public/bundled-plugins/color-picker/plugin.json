{
  "id": "color-picker",
  "name": "取色与配色",
  "version": "2.1.7",
  "description": "支持 HEX / RGB / HSL / CMYK 色值实时互转、WCAG 无障碍对比度检测与常用色板收藏",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "alias": "clr",
  "permissions": [
    "clipboard"
  ],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "nativeComponents": [],
  "keywords": [
    "color",
    "颜色",
    "hex",
    "rgb",
    "hsl",
    "oklch",
    "调色板"
  ],
  "features": [
    {
      "code": "convert-color",
      "explain": "HEX / RGB / HSL / OKLCH 色值互转",
      "mode": "view",
      "cmds": [
        "色值转换",
        "颜色转换",
        "hex转rgb",
        "rgb转hex",
        "oklch",
        "cmyk"
      ]
    },
    {
      "code": "contrast-check",
      "explain": "前景色与背景色的 WCAG 无障碍对比度检测",
      "mode": "view",
      "cmds": [
        "对比度",
        "无障碍对比度",
        "wcag",
        "配色方案"
      ]
    }
  ],
  "category": [
    "图像媒体"
  ],
  "categoryId": "media",
  "minAppVersion": "1.1.8.3",
  "defaultLocale": "zh-CN",
  "i18n": {
    "en-US": {
      "name": "Color Picker",
      "description": "Convert between HEX, RGB, HSL, OKLCH, and CMYK color formats in real time, check WCAG accessibility contrast ratios, and save favorite palettes.",
      "keywords": [
        "color",
        "hex",
        "rgb",
        "hsl",
        "oklch",
        "cmyk",
        "wcag",
        "contrast",
        "palette"
      ],
      "features": {
        "convert-color": {
          "explain": "Convert color values between HEX, RGB, HSL, OKLCH, and CMYK",
          "cmds": [
            "color convert",
            "hex to rgb",
            "rgb to hex",
            "oklch",
            "cmyk",
            "hsl"
          ]
        },
        "contrast-check": {
          "explain": "Check WCAG accessibility contrast ratio between foreground and background colors",
          "cmds": [
            "contrast",
            "wcag",
            "contrast check",
            "color accessibility"
          ]
        }
      }
    }
  }
}
