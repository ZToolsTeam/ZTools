{
  "id": "batch-image",
  "name": "图片压缩",
  "description": "批量压缩与转换 PNG/JPG/WebP/BMP 图片：三档画质重新编码、限制最长边、转 JPG/PNG、扫描件转灰度，报销附件场景会标出仍超过 300KB 的图片；结果另存为原图同目录的 *_opt 文件，不覆盖原图",
  "version": "1.1.4",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "alias": "img",
  "category": [
    "图像媒体",
    "办公效率"
  ],
  "keywords": [
    "image",
    "compress",
    "png",
    "jpg",
    "webp",
    "图片压缩",
    "格式转换",
    "图片转jpg",
    "图片缩放"
  ],
  "features": [
    {
      "code": "preset-lossless",
      "explain": "图片批量压缩",
      "mode": "view",
      "cmds": [
        "图片压缩",
        "压缩图片",
        "图片瘦身"
      ]
    },
    {
      "code": "preset-gov-limit",
      "explain": "报销/政务附件压缩（标出超过 300KB 的图片）",
      "mode": "view",
      "cmds": [
        "证件照压缩",
        "300kb",
        "政务上传",
        "报销附图"
      ]
    },
    {
      "code": "preset-to-jpg",
      "explain": "PNG/WebP/BMP 批量转 JPG",
      "mode": "view",
      "cmds": [
        "图片格式转换",
        "webp转jpg",
        "png转jpg",
        "转jpg"
      ]
    },
    {
      "code": "preset-doc-bw",
      "explain": "扫描件转灰度",
      "mode": "view",
      "cmds": [
        "扫描件转灰度",
        "图片转灰度",
        "黑白扫描件"
      ]
    }
  ],
  "permissions": [
    "fs",
    "clipboard",
    "shell"
  ],
  "requireAdmin": false,
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    }
  ]
}
