{
  "id": "crypto-tool",
  "name": "编码与加密",
  "version": "1.1.5",
  "description": "支持 Base64 / URL / Unicode / Hex 编码互转、MD5 / SHA 哈希计算、AES 加解密、HMAC 计算与 UUID 批量生成",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "alias": "enc",
  "permissions": [
    "clipboard",
    "crypto"
  ],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "nativeComponents": [],
  "keywords": [
    "md5",
    "sha",
    "sha256",
    "hash",
    "哈希",
    "aes",
    "hmac",
    "加密",
    "解密",
    "base64",
    "url编码",
    "编码转换",
    "unicode",
    "uuid",
    "guid"
  ],
  "features": [
    {
      "code": "codec-base64",
      "explain": "Base64 编码与解码",
      "mode": "view",
      "cmds": [
        "base64",
        "base64解码",
        "base64编码",
        "编码转换",
        "文本转码"
      ]
    },
    {
      "code": "codec-url",
      "explain": "URL 组件编码与解码 (encodeURIComponent)",
      "mode": "view",
      "cmds": [
        "url编码",
        "url解码",
        "urlencode",
        "urldecode",
        "转义"
      ]
    },
    {
      "code": "hash-digest",
      "explain": "计算 MD5 / SHA-1 / SHA-256 / SHA-512 散列",
      "mode": "view",
      "cmds": [
        "md5",
        "sha1",
        "sha256",
        "sha512",
        "哈希",
        "散列",
        "摘要",
        "hash"
      ]
    },
    {
      "code": "cipher-aes",
      "explain": "AES 对称加密与解密",
      "mode": "view",
      "cmds": [
        "aes",
        "aes加密",
        "aes解密",
        "加密解密"
      ]
    },
    {
      "code": "cipher-hmac",
      "explain": "HMAC 计算（SHA-256 / SHA-512 / SHA-1 / MD5）",
      "mode": "view",
      "cmds": [
        "hmac",
        "hmac计算",
        "hmac-sha256"
      ]
    },
    {
      "code": "codec-unicode",
      "explain": "Unicode 编码与解码",
      "mode": "view",
      "cmds": [
        "unicode编码",
        "unicode解码"
      ]
    },
    {
      "code": "codec-hex",
      "explain": "UTF-8 Hex 编码与解码",
      "mode": "view",
      "cmds": [
        "hex编码",
        "hex解码"
      ]
    },
    {
      "code": "gen-uuid",
      "explain": "UUID v4 / v7 / v1 批量生成与格式切换",
      "mode": "view",
      "cmds": [
        "uuid",
        "guid",
        "生成uuid",
        "uuid v7"
      ]
    }
  ],
  "category": [
    "开发工具"
  ],
  "categoryId": "developer",
  "defaultLocale": "zh-CN",
  "i18n": {
    "en-US": {
      "name": "Codec",
      "description": "Encode/decode Base64, URL, Unicode, and Hex; compute MD5/SHA hashes and HMAC signatures; encrypt/decrypt with AES; and batch generate UUID v4.",
      "keywords": [
        "base64",
        "url",
        "unicode",
        "hex",
        "md5",
        "sha256",
        "hash",
        "aes",
        "hmac",
        "uuid"
      ],
      "features": {
        "codec-base64": {
          "explain": "Encode and decode Base64 text",
          "cmds": [
            "base64",
            "base64 encode",
            "base64 decode"
          ]
        },
        "codec-url": {
          "explain": "Encode and decode URL components (encodeURIComponent)",
          "cmds": [
            "urlencode",
            "urldecode",
            "url encode",
            "url decode"
          ]
        },
        "hash-digest": {
          "explain": "Compute MD5, SHA-1, SHA-256, and SHA-512 digests",
          "cmds": [
            "hash",
            "md5",
            "sha1",
            "sha256",
            "sha512",
            "digest"
          ]
        },
        "cipher-aes": {
          "explain": "AES symmetric encryption and decryption",
          "cmds": [
            "aes",
            "aes encrypt",
            "aes decrypt",
            "cipher"
          ]
        },
        "cipher-hmac": {
          "explain": "Compute HMAC signatures (SHA-256, SHA-512, SHA-1, MD5)",
          "cmds": [
            "hmac",
            "hmac-sha256",
            "hmac sign"
          ]
        },
        "codec-unicode": {
          "explain": "Encode and decode Unicode escape sequences",
          "cmds": [
            "unicode",
            "unicode encode",
            "unicode decode"
          ]
        },
        "codec-hex": {
          "explain": "Encode and decode UTF-8 Hex strings",
          "cmds": [
            "hex",
            "hex encode",
            "hex decode"
          ]
        },
        "gen-uuid": {
          "explain": "Batch generate UUID v4, v7 (time-ordered), and v1 identifiers with format switching",
          "cmds": [
            "uuid",
            "guid",
            "generate uuid",
            "uuid v4",
            "uuid v7"
          ]
        }
      },
      "screenshots": [
        {
          "file": "screenshots/en-US/01.png",
          "title": "Encoding & Hashing"
        }
      ]
    }
  },
  "screenshots": [
    {
      "path": "screenshots/01.png",
      "title": "常用编码与哈希"
    }
  ]
}
