{
  "id": "file-compare",
  "name": "文本对比",
  "version": "2.0.13",
  "description": "逐行对比两段文本、代码或配置文件，逐处列出增删的行，支持忽略空白与复制 unified diff 差异报告",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "permissions": [
    "clipboard",
    "dialog",
    "fs"
  ],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "nativeComponents": [],
  "keywords": [
    "diff",
    "对比",
    "比较",
    "compare",
    "差异"
  ],
  "category": [
    "开发工具"
  ],
  "categoryId": "developer",
  "defaultLocale": "zh-CN",
  "i18n": {
    "en-US": {
      "name": "Text Diff",
      "description": "Compare two text blocks, code snippets, or config files line by line, highlight additions and deletions, ignore whitespace, and copy unified diff output.",
      "keywords": [
        "diff",
        "compare",
        "text diff",
        "patch",
        "unified diff"
      ],
      "screenshots": [
        {
          "file": "screenshots/en-US/01.png",
          "title": "Main View"
        }
      ]
    }
  },
  "screenshots": [
    {
      "path": "screenshots/01.png",
      "title": "主界面"
    }
  ]
}
