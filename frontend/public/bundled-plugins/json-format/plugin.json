{
  "id": "json-format",
  "name": "JSON 格式化",
  "version": "2.1.6",
  "description": "JSON 语法校验、高亮美化与压缩转义，支持一键生成 TypeScript / Go / Rust 数据结构定义",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "alias": "json",
  "permissions": [
    "clipboard"
  ],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "nativeComponents": [],
  "keywords": [
    "json",
    "格式化",
    "format",
    "minify",
    "压缩",
    "校验",
    "json转ts"
  ],
  "features": [
    {
      "code": "json-beautify",
      "explain": "JSON 美化与语法校验",
      "mode": "view",
      "cmds": [
        "json格式化",
        "json美化",
        "json校验",
        "json"
      ]
    },
    {
      "code": "json-codegen",
      "explain": "JSON 生成 TypeScript / Go / Rust 类型",
      "mode": "view",
      "cmds": [
        "json转ts",
        "json转go",
        "生成类型",
        "interface生成"
      ]
    }
  ],
  "category": [
    "开发工具"
  ],
  "categoryId": "developer",
  "defaultLocale": "zh-CN",
  "i18n": {
    "en-US": {
      "name": "JSON Format",
      "description": "Validate, format, minify, and escape JSON with syntax highlighting, plus one-click TypeScript, Go, and Rust type generation.",
      "keywords": [
        "json",
        "format",
        "beautify",
        "minify",
        "validate",
        "typescript",
        "codegen"
      ],
      "features": {
        "json-beautify": {
          "explain": "Beautify, minify, and validate JSON syntax",
          "cmds": [
            "json",
            "json format",
            "json beautify",
            "json validate",
            "json minify"
          ]
        },
        "json-codegen": {
          "explain": "Generate TypeScript, Go, or Rust type definitions from JSON",
          "cmds": [
            "json to ts",
            "json to go",
            "json to rust",
            "json codegen"
          ]
        }
      }
    }
  }
}
