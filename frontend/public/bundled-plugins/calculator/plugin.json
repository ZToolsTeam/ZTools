{
  "id": "calculator",
  "name": "计算器",
  "version": "2.1.2",
  "description": "输入算式即时计算，内置科学函数、单位换算、每日汇率、人民币大写金额转换与日期推算",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "alias": "calc",
  "permissions": [
    "clipboard",
    "network"
  ],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "nativeComponents": [],
  "keywords": [
    "calc",
    "计算",
    "计算器",
    "换算",
    "单位",
    "汇率",
    "大写金额"
  ],
  "features": [
    {
      "code": "calc-unit",
      "explain": "长度/重量/存储/温度单位换算",
      "mode": "view",
      "cmds": [
        "单位换算",
        "长度换算",
        "重量换算",
        "存储换算",
        "温度换算"
      ]
    },
    {
      "code": "calc-currency",
      "explain": "每日多币种汇率换算",
      "mode": "view",
      "cmds": [
        "汇率换算",
        "汇率",
        "美元人民币",
        "外币换算"
      ]
    },
    {
      "code": "calc-rmb",
      "explain": "财务人民币大写金额转换",
      "mode": "view",
      "cmds": [
        "大写金额",
        "人民币大写",
        "财务大写",
        "数字转大写"
      ]
    }
  ],
  "category": [
    "效率工具"
  ]
}
