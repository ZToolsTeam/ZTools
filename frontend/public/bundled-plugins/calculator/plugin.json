{
  "id": "calculator",
  "name": "计算器",
  "version": "2.2.1",
  "description": "输入算式即时计算，内置科学函数、单位换算、多币种实时汇率（含黄金/比特币）、人民币大写金额转换与日期推算",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "alias": "calc",
  "permissions": [
    "clipboard",
    "network"
  ],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "nativeComponents": [],
  "keywords": [
    "calc",
    "计算",
    "计算器",
    "换算",
    "单位",
    "汇率",
    "exchange rate",
    "currency",
    "货币",
    "美元",
    "欧元",
    "日元",
    "黄金",
    "gold",
    "XAU",
    "比特币",
    "bitcoin",
    "BTC",
    "大写金额"
  ],
  "features": [
    {
      "code": "calc-unit",
      "explain": "长度/重量/存储/温度单位换算",
      "mode": "view",
      "cmds": [
        "单位换算",
        "长度换算",
        "重量换算",
        "存储换算",
        "温度换算"
      ]
    },
    {
      "code": "calc-currency",
      "explain": "实时汇率查询与多币种换算（含黄金、比特币）",
      "mode": "view",
      "cmds": [
        "汇率换算",
        "汇率计算",
        "汇率",
        "exchange rate",
        "currency",
        "美元人民币",
        "外币换算",
        "黄金价格",
        "比特币价格"
      ]
    },
    {
      "code": "calc-rmb",
      "explain": "财务人民币大写金额转换",
      "mode": "view",
      "cmds": [
        "大写金额",
        "人民币大写",
        "财务大写",
        "数字转大写"
      ]
    }
  ],
  "category": [
    "办公效率"
  ],
  "categoryId": "productivity",
  "minAppVersion": "1.1.8.3",
  "defaultLocale": "zh-CN",
  "i18n": {
    "en-US": {
      "name": "Calculator",
      "description": "Instant expression calculator with scientific functions, unit conversions, live multi-currency exchange rates (including gold and Bitcoin), Chinese RMB uppercase formatting, and date math.",
      "keywords": [
        "calc",
        "calculator",
        "math",
        "unit",
        "currency",
        "exchange rate",
        "gold",
        "bitcoin"
      ],
      "features": {
        "calc-unit": {
          "explain": "Convert length, weight, storage, and temperature units",
          "cmds": [
            "unit convert",
            "length convert",
            "weight convert",
            "temperature convert"
          ]
        },
        "calc-currency": {
          "explain": "Live exchange rates and multi-currency conversion (including gold and Bitcoin)",
          "cmds": [
            "exchange rate",
            "currency",
            "currency converter",
            "gold price",
            "btc price"
          ]
        },
        "calc-rmb": {
          "explain": "Convert numbers to Chinese financial uppercase RMB format",
          "cmds": [
            "rmb uppercase",
            "chinese currency",
            "financial uppercase"
          ]
        }
      },
      "screenshots": [
        {
          "file": "screenshots/en-US/01.png",
          "title": "Instant Expression Evaluation"
        }
      ]
    }
  },
  "screenshots": [
    {
      "path": "screenshots/02-action-panel.png"
    }
  ]
}
