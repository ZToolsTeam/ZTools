      "category": [
        "开发工具"
      ],
      "keywords": [
        "json",
        "格式化",
        "format",
        "minify",
        "压缩",
        "校验",
        "json转ts"
      ],
      "alias": "json",
      "features": [
        {
          "code": "json-beautify",
          "explain": "JSON 美化与语法校验",
          "mode": "view",
