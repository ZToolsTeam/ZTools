{
  "plugins": [
    {
      "id": "json-format",
      "name": "JSON 格式化",
      "description": "JSON 语法校验、高亮美化与压缩转义，支持一键生成 TypeScript / Go / Rust 数据结构定义",
      "version": "2.1.3",
      "author": "ZTools Team",
      "icon": "icon.svg",
      "category": [
        "开发工具"
      ],
      "keywords": [
        "json",
        "格式化",
        "format",
        "minify",
        "压缩",
        "校验",
        "json转ts"
      ],
      "alias": "json",
      "features": [
        {
          "code": "json-beautify",
          "explain": "JSON 美化与语法校验",
          "mode": "view",
          "cmds": [
            "json格式化",
            "json美化",
            "json校验",
            "json"
          ]
        },
        {
          "code": "json-codegen",
          "explain": "JSON 生成 TypeScript / Go / Rust 类型",
          "mode": "view",
          "cmds": [
            "json转ts",
            "json转go",
            "生成类型",
            "interface生成"
          ]
        }
      ],
      "targets": [
        {
          "id": "windows-electron-any",
          "platform": "windows",
          "runtime": "electron",
          "arch": "any"
        },
        {
          "id": "macos-electron-any",
          "platform": "macos",
          "runtime": "electron",
          "arch": "any"
        }
      ],
      "files": [
        "plugin.json",
        "icon.svg",
        "dist/index.js",
        "dist/logic.js",
        "dist/popout-state.js"
      ]
    },
    {
